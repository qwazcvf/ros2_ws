<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="phase2b_factory">
    <gravity>0 0 -9.8</gravity>

    <include>
      <uri>model://sun</uri>
    </include>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>50 50</size></plane></geometry>
          <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>50 50</size></plane></geometry>
          <material><ambient>0.3 0.3 0.3</ambient><diffuse>0.5 0.5 0.5</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Shelf rack -->
    <model name="shelf_1">
      <static>true</static>
      <pose>3 2 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.2 0.8 3.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.2 0.8 3.0</size></box></geometry>
          <material><ambient>0.5 0.4 0.3</ambient></material>
        </visual>
      </link>
    </model>

    <!-- Cargo box -->
    <model name="cargo_1">
      <static>true</static>
      <pose>-3 -2 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.8 0.6 1.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.8 0.6 1.2</size></box></geometry>
          <material><ambient>0.6 0.4 0.2</ambient></material>
        </visual>
      </link>
    </model>

    <!-- Pillar -->
    <model name="pillar_1">
      <static>true</static>
      <pose>-1 -4 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.15</radius><length>3.0</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.15</radius><length>3.0</length></cylinder></geometry>
          <material><ambient>0.5 0.5 0.5</ambient></material>
        </visual>
      </link>
    </model>

    <!-- Wall east -->
    <model name="wall_east">
      <static>true</static>
      <pose>0 6 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>10 0.3 3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10 0.3 3</size></box></geometry>
          <material><ambient>0.7 0.65 0.55</ambient></material>
        </visual>
      </link>
    </model>

    <!-- Wall west -->
    <model name="wall_west">
      <static>true</static>
      <pose>0 -6 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>10 0.3 3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10 0.3 3</size></box></geometry>
          <material><ambient>0.7 0.65 0.55</ambient></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
