<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="inspection_bot">

  <material name="white">  <color rgba="0.95 0.95 0.95 1.0"/></material>
  <material name="dark">   <color rgba="0.15 0.15 0.15 1.0"/></material>
  <material name="grey">   <color rgba="0.45 0.45 0.45 1.0"/></material>
  <material name="blue">   <color rgba="0.10 0.30 0.80 1.0"/></material>
  <material name="red">    <color rgba="0.90 0.15 0.10 1.0"/></material>
  <material name="orange">      <color rgba="1.00 0.45 0.00 1.0"/></material>
  <material name="light_grey">  <color rgba="0.75 0.75 0.75 1.0"/></material>
  <material name="grey_acrylic"><color rgba="0.55 0.55 0.55 0.35"/></material>
  <material name="grey_frame">  <color rgba="0.35 0.35 0.35 1.0"/></material>

  <!--
    CORNER MACRO
    Tree: base_link -> steering_joint -> steering_link -> wheel_joint -> wheel_link
    steering_z = Z of steering joint on base_link
    wheel_drop = Z offset from steering_link to wheel center (negative = down)
    wheel_center_z = steering_z + wheel_drop = -0.055 + (-0.124) = -0.179
  -->
  <xacro:macro name="corner" params="prefix x y steering_z wheel_drop side steering_type:=continuous">

    <!-- Steering link: servo turntable + column + fork arms + shock -->
    <link name="${prefix}_steering_link">
      <inertial>
        <origin xyz="0 0 -0.06"/>
        <mass value="1.0"/>
        <inertia ixx="0.002" ixy="0.0" ixz="0.0" iyy="0.002" iyz="0.0" izz="0.002"/>
      </inertial>

      <!-- upper steering disk / servo turntable -->
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.065" length="0.025"/>
        </geometry>
        <material name="grey"/>
      </visual>

      <!-- vertical steering column -->
      <visual>
        <origin xyz="0 0 -0.055" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.028" length="0.11"/>
        </geometry>
        <material name="dark"/>
      </visual>

      <!-- outer fork arm (farther from wheel) -->
      <visual>
        <origin xyz="0 ${side * 0.065} -0.105" rpy="0 0 0"/>
        <geometry>
          <box size="0.025 0.012 0.13"/>
        </geometry>
        <material name="grey"/>
      </visual>

      <!-- inner fork arm (closer to wheel, but not touching) -->
      <visual>
        <origin xyz="0 ${side * 0.03} -0.105" rpy="0 0 0"/>
        <geometry>
          <box size="0.025 0.012 0.13"/>
        </geometry>
        <material name="grey"/>
      </visual>

      <!-- simplified shock absorber (offset to side, visual only) -->
      <visual>
        <origin xyz="-0.055 ${side * 0.085} -0.095" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.012" length="0.09"/>
        </geometry>
        <material name="orange"/>
      </visual>

      <!-- tight collision around steering column only, avoid wheel overlap -->
      <collision>
        <origin xyz="0 0 -0.055" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.03" length="0.08"/>
        </geometry>
      </collision>
    </link>

    <!-- Steering joint: strong damping prevents self-steer on spawn -->
    <joint name="${prefix}_steering_joint" type="${steering_type}">
      <parent link="base_link"/>
      <child link="${prefix}_steering_link"/>
      <origin xyz="${x} ${y} ${steering_z}" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <dynamics damping="5.0" friction="1.0"/>
    </joint>

    <!-- Wheel link -->
    <link name="${prefix}_wheel_link">
      <inertial>
        <origin xyz="0 0 0"/>
        <mass value="0.8"/>
        <inertia ixx="0.002" ixy="0.0" ixz="0.0" iyy="0.002" iyz="0.0" izz="0.002"/>
      </inertial>

      <!--
        Default cylinder axis = Z.
        rpy="-1.5708 0 0" rotates -90 deg around X: Z -> Y, Y -> Z.
        Cylinder now lies along Y (left-right).
        Circular face in XZ plane, visible as a proper round wheel from the side.
      -->
      <visual>
        <origin xyz="0 0 0" rpy="-1.5708 0 0"/>
        <geometry>
          <cylinder radius="0.076" length="0.04"/>
        </geometry>
        <material name="dark"/>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="-1.5708 0 0"/>
        <geometry>
          <cylinder radius="0.076" length="0.04"/>
        </geometry>
      </collision>
    </link>

    <!-- Wheel joint: axis Y for forward/backward rolling. Offset downward from steering_link. -->
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="${prefix}_steering_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="0 0 ${wheel_drop}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.1" friction="0.02"/>
    </joint>

  </xacro:macro>


  <!-- BASE LINK: chassis board + wireframe shell + support columns + sensor mounts -->
  <link name="base_link">

    <!-- bottom chassis board -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.806 0.607 0.03"/>
      </geometry>
      <material name="light_grey"/>
    </visual>

    <!-- top panel: semi-transparent grey acrylic -->
    <visual>
      <origin xyz="0 0 0.30" rpy="0 0 0"/>
      <geometry>
        <box size="0.806 0.607 0.008"/>
      </geometry>
      <material name="grey_acrylic"/>
    </visual>

    <!-- bottom edge: left long -->
    <visual>
      <origin xyz="0 0.3035 0.015" rpy="0 0 0"/>
      <geometry><box size="0.806 0.012 0.012"/></geometry>
      <material name="grey_frame"/>
    </visual>
    <!-- bottom edge: right long -->
    <visual>
      <origin xyz="0 -0.3035 0.015" rpy="0 0 0"/>
      <geometry><box size="0.806 0.012 0.012"/></geometry>
      <material name="grey_frame"/>
    </visual>
    <!-- bottom edge: front short -->
    <visual>
      <origin xyz="0.403 0 0.015" rpy="0 0 0"/>
      <geometry><box size="0.012 0.607 0.012"/></geometry>
      <material name="grey_frame"/>
    </visual>
    <!-- bottom edge: rear short -->
    <visual>
      <origin xyz="-0.403 0 0.015" rpy="0 0 0"/>
      <geometry><box size="0.012 0.607 0.012"/></geometry>
      <material name="grey_frame"/>
    </visual>

    <!-- top edge: left long -->
    <visual>
      <origin xyz="0 0.3035 0.30" rpy="0 0 0"/>
      <geometry><box size="0.806 0.012 0.012"/></geometry>
      <material name="grey_frame"/>
    </visual>
    <!-- top edge: right long -->
    <visual>
      <origin xyz="0 -0.3035 0.30" rpy="0 0 0"/>
      <geometry><box size="0.806 0.012 0.012"/></geometry>
      <material name="grey_frame"/>
    </visual>
    <!-- top edge: front short -->
    <visual>
      <origin xyz="0.403 0 0.30" rpy="0 0 0"/>
      <geometry><box size="0.012 0.607 0.012"/></geometry>
      <material name="grey_frame"/>
    </visual>
    <!-- top edge: rear short -->
    <visual>
      <origin xyz="-0.403 0 0.30" rpy="0 0 0"/>
      <geometry><box size="0.012 0.607 0.012"/></geometry>
      <material name="grey_frame"/>
    </visual>

    <!-- vertical pillars: 4 corners -->
    <visual>
      <origin xyz="0.403 0.3035 0.15" rpy="0 0 0"/>
      <geometry><box size="0.012 0.012 0.30"/></geometry>
      <material name="grey_frame"/>
    </visual>
    <visual>
      <origin xyz="0.403 -0.3035 0.15" rpy="0 0 0"/>
      <geometry><box size="0.012 0.012 0.30"/></geometry>
      <material name="grey_frame"/>
    </visual>
    <visual>
      <origin xyz="-0.403 0.3035 0.15" rpy="0 0 0"/>
      <geometry><box size="0.012 0.012 0.30"/></geometry>
      <material name="grey_frame"/>
    </visual>
    <visual>
      <origin xyz="-0.403 -0.3035 0.15" rpy="0 0 0"/>
      <geometry><box size="0.012 0.012 0.30"/></geometry>
      <material name="grey_frame"/>
    </visual>

    <!-- black support columns (internal structure) -->
    <visual>
      <origin xyz="0.25 0.20 0.15" rpy="0 0 0"/>
      <geometry><cylinder radius="0.018" length="0.30"/></geometry>
      <material name="dark"/>
    </visual>
    <visual>
      <origin xyz="0.25 -0.20 0.15" rpy="0 0 0"/>
      <geometry><cylinder radius="0.018" length="0.30"/></geometry>
      <material name="dark"/>
    </visual>
    <visual>
      <origin xyz="-0.25 0.20 0.15" rpy="0 0 0"/>
      <geometry><cylinder radius="0.018" length="0.30"/></geometry>
      <material name="dark"/>
    </visual>
    <visual>
      <origin xyz="-0.25 -0.20 0.15" rpy="0 0 0"/>
      <geometry><cylinder radius="0.018" length="0.30"/></geometry>
      <material name="dark"/>
    </visual>
    <visual>
      <origin xyz="0.0 0.0 0.15" rpy="0 0 0"/>
      <geometry><cylinder radius="0.018" length="0.30"/></geometry>
      <material name="dark"/>
    </visual>

    <!-- Lidar mounting column -->
    <visual>
      <origin xyz="0.36101 -0.000993 0.325" rpy="0 0 0"/>
      <geometry><cylinder radius="0.025" length="0.05"/></geometry>
      <material name="dark"/>
    </visual>
    <!-- Lidar mounting base disk -->
    <visual>
      <origin xyz="0.36101 -0.000993 0.30" rpy="0 0 0"/>
      <geometry><cylinder radius="0.055" length="0.012"/></geometry>
      <material name="dark"/>
    </visual>

    <!-- Camera mounting bracket -->
    <visual>
      <origin xyz="0.4056 0 0.17" rpy="0 0 0"/>
      <geometry><box size="0.04 0.04 0.08"/></geometry>
      <material name="dark"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.806 0.607 0.03"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="5.0"/>
      <inertia
        ixx="${5.0/12.0 * (0.607*0.607 + 0.03*0.03)}"
        ixy="0.0" ixz="0.0"
        iyy="${5.0/12.0 * (0.806*0.806 + 0.03*0.03)}"
        iyz="0.0"
        izz="${5.0/12.0 * (0.806*0.806 + 0.607*0.607)}"/>
    </inertial>
  </link>


  <!-- FOUR CORNERS -->
  <xacro:corner prefix="fl" x="0.2316"  y="0.238"  steering_z="-0.055" wheel_drop="-0.124" side="1"/>
  <xacro:corner prefix="fr" x="0.2316"  y="-0.238" steering_z="-0.055" wheel_drop="-0.124" side="-1"/>
  <xacro:corner prefix="rl" x="-0.2284" y="0.238"  steering_z="-0.055" wheel_drop="-0.124" side="1"  steering_type="fixed"/>
  <xacro:corner prefix="rr" x="-0.2284" y="-0.238" steering_z="-0.055" wheel_drop="-0.124" side="-1" steering_type="fixed"/>


  <!-- LIDAR -->
  <link name="lidar_link">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.12"/>
      <inertia ixx="0.00005" ixy="0.0" ixz="0.0" iyy="0.00004" iyz="0.0" izz="0.00007"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.06"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.06"/>
      </geometry>
    </collision>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.36101 -0.000993 0.35253" rpy="0 0 0"/>
  </joint>


  <!-- CAMERA -->
  <link name="camera_link">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.00005" ixy="0.0" ixz="0.0" iyy="0.00005" iyz="0.0" izz="0.00005"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.035 0.035"/>
      </geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.035 0.035"/>
      </geometry>
    </collision>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.4056 0 0.21" rpy="0 0 0"/>
  </joint>


  <!-- ros2_control hardware interfaces -->
  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>ign_ros2_control/IgnitionSystem</plugin>
    </hardware>

    <joint name="fl_steering_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="fr_steering_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <!-- Phase 2A: rear steering joints are fixed (not in ros2_control) -->

    <joint name="fl_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="fr_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="rl_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="rr_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>


  <gazebo>
    <plugin
      filename="libgz_ros2_control-system.so"
      name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <robot_param>robot_description</robot_param>
      <robot_param_node>robot_state_publisher</robot_param_node>
      <parameters>$(find inspection_bot_description)/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>

  <gazebo reference="base_link"><material>Gazebo/White</material></gazebo>
  <gazebo reference="fl_steering_link"><material>Gazebo/Grey</material></gazebo>
  <gazebo reference="fr_steering_link"><material>Gazebo/Grey</material></gazebo>
  <gazebo reference="rl_steering_link"><material>Gazebo/Grey</material></gazebo>
  <gazebo reference="rr_steering_link"><material>Gazebo/Grey</material></gazebo>
  <!-- High friction for proper Ackermann steering grip -->
  <gazebo reference="fl_wheel_link">
    <mu1>1.5</mu1><mu2>1.5</mu2>
    <material>Gazebo/FlatBlack</material>
  </gazebo>
  <gazebo reference="fr_wheel_link">
    <mu1>1.5</mu1><mu2>1.5</mu2>
    <material>Gazebo/FlatBlack</material>
  </gazebo>
  <gazebo reference="rl_wheel_link">
    <mu1>1.5</mu1><mu2>1.5</mu2>
    <material>Gazebo/FlatBlack</material>
  </gazebo>
  <gazebo reference="rr_wheel_link">
    <mu1>1.5</mu1><mu2>1.5</mu2>
    <material>Gazebo/FlatBlack</material>
  </gazebo>
  <!-- Phase 2B-1: 2D Lidar sensor on lidar_link -->
  <gazebo reference="lidar_link">
    <material>Gazebo/Blue</material>
    <sensor name="lidar_2d" type="gpu_lidar">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.1</min>
          <max>15.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>
  <gazebo reference="camera_link"><material>Gazebo/Red</material></gazebo>

</robot>
